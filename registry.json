{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "vinkas-ui",
  "homepage": "https://ui.vinkas.com",
  "items": [
    {
      "name": "relative-time",
      "type": "registry:ui",
      "title": "Relative Time",
      "description": "A component that displays current relative time to the given input",
      "registryDependencies": [
        "tooltip"
      ],
      "files": [
        {
          "path": "registry/vinkas/ui/relative-time.tsx",
          "type": "registry:ui",
          "target": "components/vinkas/ui/relative-time.tsx"
        }
      ]
    },
    {
      "name": "input-copyable",
      "type": "registry:ui",
      "title": "Input Copyable",
