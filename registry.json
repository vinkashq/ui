        "input-group",
        "tooltip"
      ],
      "dependencies": [
        "usehooks-ts"
      ],
      "files": [
        {
          "path": "registry/vinkas/ui/input-copyable.tsx",
          "type": "registry:ui",
          "target": "components/vinkas/ui/input-copyable.tsx"
        }
      ]
    },
    {
      "name": "utm-link",
      "type": "registry:ui",
      "title": "UTM Link",
      "description": "A link component that automatically adds UTM parameters to the href on click",
      "files": [
        {
          "path": "registry/vinkas/ui/utm-link.tsx",
          "type": "registry:ui",
          "target": "components/vinkas/ui/utm-link.tsx"
        }
      ]
    }
